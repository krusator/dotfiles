#!/usr/bin/env bash
cd ~/Projects || exit
SELECTED_DIR=$(find ~/Projects ~/Projects/misc/innoday ~/Projects/misc/advent-of-code ~/Projects/misc/inspire ~/Projects/peng ~/Projects/misc ~/dotfiles ~/tools -maxdepth 1 -type d | fzf)
echo "$SELECTED_DIR"
cd "$SELECTED_DIR" || exit
# tmux replaces '.' and ':' in session names with '_'
NAME=$(basename "$SELECTED_DIR" | tr '.:' '__')
tmux new-session -s "$NAME" -d
tmux rename-window -t "$NAME" "$NAME"
tmux send-keys -t "$NAME" "vi ." Enter
tmux switch-client -t "$NAME" || tmux attach -t "$NAME"
